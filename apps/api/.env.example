NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

MONGODB_URI=
JWT_SECRET=
JWT_EXPIRES_IN=1d
COOKIE_NAME=local_small_admin
COOKIE_SAME_SITE=lax

# Manual testimonials use MongoDB and admin authentication only.
# No Google OAuth, Places API key or Billing configuration is required.

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Create a Managed widget and keep its secret on the API only.
# TURNSTILE_SECRET_KEY=
# TURNSTILE_HOSTNAMES=localsmalltattoo.com.vn,www.localsmalltattoo.com.vn,localhost,127.0.0.1
BOOKING_IP_LIMIT=20
BOOKING_CONTACT_LIMIT=4
BOOKING_RATE_WINDOW_MINUTES=15
BOOKING_DUPLICATE_WINDOW_MINUTES=15

# Optional studio-only booking email through Resend. Set all three to enable it.
# BOOKING_EMAIL_API_KEY=
# BOOKING_EMAIL_FROM=
# BOOKING_EMAIL_TO=

ADMIN_NAME=Studio Owner
ADMIN_EMAIL=admin@localsmalltattoo.com
ADMIN_PASSWORD=
