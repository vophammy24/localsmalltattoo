    "react-hook-form": "^7.84.0",
    "react-icons": "^5.5.0",
    "react-router": "8.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "prettier": "^3.9.6",
    "typescript": "7.0.2",
    "vite": "8.1.5"
  }
}
